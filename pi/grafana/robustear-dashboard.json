    {
      "id": 5,
      "type": "timeseries",
      "title": "Pegel RMS (dBFS, ohne DC)",
      "datasource": {
        "type": "influxdb",
        "uid": "robustear-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "robustear-influx"
          },
          "query": "from(bucket: \"robustear\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"level\" and (r._field == \"rms_l\" or r._field == \"rms_r\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": -96,
          "max": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rms_l"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Links (Mic 1)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rms_r"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rechts (Mic 2)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "peak_l"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Links (Mic 1)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "peak_r"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rechts (Mic 2)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
