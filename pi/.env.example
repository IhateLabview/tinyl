# Kopieren nach .env und ausfuellen. .env kommt NICHT ins Git.

# Mosquitto (laeuft auf demselben Pi)
MQTT_HOST=localhost
MQTT_PORT=1883
# Leer lassen, wenn Mosquitto anonyme Verbindungen erlaubt
MQTT_USER=
MQTT_PASS=

# InfluxDB 2.x  (Token: InfluxDB-Weboberflaeche -> Load Data -> API Tokens)
INFLUX_URL=http://localhost:8086
INFLUX_ORG=
INFLUX_TOKEN=
INFLUX_BUCKET=robustear
INFLUX_BUCKET_RAW=robustear_raw
# Wie lange Rohaudio aufbewahrt wird (Stunden, 0 = unbegrenzt). ~300 MB pro Stunde!
RAW_RETENTION_HOURS=48

LOG_LEVEL=INFO
